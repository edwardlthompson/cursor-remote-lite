{
  "name": "cursor-remote-lite",
  "version": "1.8.2",
  "description": "Use your desktop Cursor from your phone: chat with the Agent, approve steps, switch windows/modes/models. Free and self-hosted.",
  "type": "module",
  "main": "server.mjs",
  "scripts": {
    "setup": "node setup.mjs",
    "setup:auto": "node setup.mjs --yes",
    "bootstrap": "node setup.mjs --yes",
    "start": "node server.mjs",
    "public": "node server.mjs --tunnel",
    "pair": "node devices.mjs pair",
    "adb-pair": "node adb-pair.mjs",
    "devices": "node devices.mjs",
    "2fa": "node twofa.mjs",
    "telegram": "node telegram.mjs",
    "win": "node win-run.mjs",
    "linux": "node linux-run.mjs",
    "dist:win": "powershell -ExecutionPolicy Bypass -File .\\packaging\\windows\\build.ps1",
    "dist:linux": "bash ./packaging/linux/build.sh",
    "ext:compile": "npm --prefix extension run compile",
    "ext:package": "npm --prefix extension run package",
    "ext:publish:ovsx": "npm --prefix extension run publish:ovsx",
    "test": "node --test test/*.test.mjs",
    "test:fixtures": "node --test test/*.test.mjs",
    "reset": "node -e \"const d=require('os').homedir()+'/.cursor-remote-lite/';for(const f of ['url-key','devices.json','pairing.json','totp.json','config.json','state.json'])require('fs').rmSync(d+f,{force:true});console.log('Reset complete: re-pair all devices; two-factor is off')\""
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "cursor",
    "remote",
    "mobile",
    "cdp",
    "agent",
    "pwa"
  ],
  "license": "MIT",
  "dependencies": {
    "qrcode-terminal": "^0.12.0",
    "web-push": "^3.6.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "linkedom": "^0.18.9"
  }
}
